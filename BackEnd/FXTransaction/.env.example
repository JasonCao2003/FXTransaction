# ============================================================
# FXTransaction 环境变量模板
# 用法：复制为 .env 并填入真实值
#   cp .env.example .env
# 说明：
#   - docker compose 会自动读取本目录（BackEnd/FXTransaction/）下的 .env
#   - Spring 各服务通过环境变量读取；本地运行前可执行
#       set -a; source .env; set +a
#     或使用 spring-dotenv（见 README 说明 SPRINGDOTENV_DIRECTORY）
# .env 已被 .gitignore 忽略，不会提交。
# ============================================================

# ---------- MySQL（docker-compose 使用） ----------
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=trade_service
MYSQL_PASSWORD=your_mysql_password

# ---------- JWT 签名密钥（各服务共用，必须保持一致） ----------
JWT_KEY=your_jwt_signing_key

# ---------- 邮箱（auth-service 发送验证码） ----------
MAIL_USERNAME=your_qq@qq.com
MAIL_PASSWORD=your_qq_smtp_authorization_code

# ---------- 汇率数据 API（marketAnalysis-service） ----------
# 申请地址: https://www.exchangerate-api.com/
EXCHANGE_RATE_API_KEY=your_exchangerate_api_key

# ---------- 汇率服务独立数据库（CurrencyExchangeScheduledTask） ----------
CURRENCY_DB_URL=jdbc:mysql://localhost:3306/currency_exchange_db
CURRENCY_DB_USER=root
CURRENCY_DB_PASSWORD=your_mysql_password
