# ============================================================
# FXTransaction 前端 (React) 环境变量模板
# 用法：复制为对应环境的 env 文件，例如：
#   cp .env.example .env.development
# 说明：仅以 REACT_APP_ 开头的变量会被注入前端运行时。
# .env* 已被 .gitignore 忽略，不会提交。
# ============================================================

# 接口基础路径（axios baseURL）
REACT_APP_API_BASEURL=/api/react-ant-admin

# 开发代理目标地址（见 src/setupProxy.js）
REACT_APP_PROXY_TARGET=https://z3web.cn/

# 是否使用 Mock 数据：1 启用，0 关闭
REACT_APP_MOCK=0

# 路由 basename
REACT_APP_ROUTERBASE=/

# 是否使用 HashRouter：1 使用 HashRouter，否则 BrowserRouter
REACT_APP_ROUTER_ISHASH=0
